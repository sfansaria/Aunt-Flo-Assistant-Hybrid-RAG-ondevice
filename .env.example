# --- LLM backend ---
# Default: local Ollama. To use a hosted API instead, change these three
# and nothing else in the code needs to change.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# qwen2.5:1.5b = fastest, qwen2.5:3b = balanced, llama3.1:8b = best quality (needs 16GB RAM)
LLM_MODEL=qwen2.5:3b

# --- Embeddings / reranker ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base
# false = faster on a laptop; true = better ranking (downloads ~1GB model)
USE_RERANKER=false

# --- Vector store ---
QDRANT_PATH=./vectorstore/qdrant_db
QDRANT_COLLECTION=auntflo
BM25_INDEX_PATH=./vectorstore/bm25.pkl

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
FINAL_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Session memory ---
SESSION_DB_PATH=./sessions.db
MAX_HISTORY_TURNS=6

# --- Data ---
PDF_DIR=./data
